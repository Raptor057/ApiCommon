<Project>
  <!--
    Empaquetado NuGet propio de ApiCommon. El codigo del repo es copia 1:1 de
    Raptor-Dev-Services/Common: este archivo, `version`, CHANGELOG-NUGET.md, .github/ y
    docs/adr-nuget/ son lo unico que no viene de alla, para que sincronizar sea copiar encima
    (docs/adr-nuget/NUGET-0001).

    Cada proyecto se publica como Raptor.<Proyecto>: Raptor.Common (la facade) depende
    de Raptor.Common.Contracts, .Messaging, .MultiTenancy, .Infra y .Web (NUGET-0002).
    `version` lleva el numero del tag de Common que se copio (NUGET-0003).
  -->
  <PropertyGroup>
    <PackageId>Raptor.$(MSBuildProjectName)</PackageId>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)version').Trim())</Version>
    <Authors>Rogelio Arriaga</Authors>
    <Company>Raptor057</Company>
    <Description>Library for Raptor057's personal use APIs ($(MSBuildProjectName)).</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Raptor057/ApiCommon</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Raptor057/ApiCommon</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>
</Project>
